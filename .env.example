# PostgreSQL Database Connection URL
# For local Docker Compose:
DATABASE_URL=postgres://bubl:bubl_secret_password@localhost:5432/bubl_db
# Or Cloud PostgreSQL (Neon Serverless Postgres):
# DATABASE_URL=postgresql://user:pass@ep-cool-fog.us-east-2.aws.neon.tech/bubl?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-cool-fog.us-east-2.aws.neon.tech/bubl?sslmode=require
# NEON_BRANCH=production

# Neon Auth Services
# NEON_AUTH_BASE_URL=https://<project-id>.neonauth.region.aws.neon.tech/<db>/auth
# NEON_AUTH_JWKS_URL=https://<project-id>.neonauth.region.aws.neon.tech/<db>/auth/.well-known/jwks.json

# Server Configuration
PORT=3001
NODE_ENV=development
SESSION_SECRET=bubl_super_secret_session_key_32chars_min_length_required

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
