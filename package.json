{
  "name": "bubl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx server/index.ts",
    "server:bun": "bun run server/index.ts",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run server\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build:all": "vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "tsx test-e2e.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.38.4",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "hono": "^4.7.2",
    "jose": "^6.2.14",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^3.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.37.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
